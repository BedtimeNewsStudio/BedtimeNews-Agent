# Template for the .env subset that MUST be environment variables:
# docker compose interpolation, the postgres official image / init.sh, and
# compose port mappings. Everything else lives in config.yml (see its template
# config.example.yml). The two files are intentionally disjoint.

# Docker image tag ("latest" tracks the newest release). Pins the indexer (data
# layer) and, by fallback, the application (agent + web).
IMAGE_TAG=latest

# Host port for the web service (plain HTTP, no TLS). Fallback for APP_PORT.
FRONTEND_PORT=8080

# Per-instance application variables (blue-green deployments, see
# compose.app.yml and docs/designs/20261008_blue-green-deployment.md). A
# deployment tool passes them on the command line for each instance. Do NOT
# set them here: an argument-less `docker compose` would then bring that
# version back. Self-hosting needs none of them.
#   APP_IMAGE_TAG=            agent + web version (fallback: IMAGE_TAG)
#   APP_PORT=                 host port of this instance's web (fallback: FRONTEND_PORT)
#   APP_INSTANCE=             label reported by /healthz (fallback: local)
#   BEDTIMENEWS_NET_NAME=     data-layer network, production: bedtimenews-agent_bedtimenews_net
#   BEDTIMENEWS_NET_EXTERNAL= true: join the data layer's network
#   APP_CONFIG_FILE=          host path of this instance's config.yml (fallback: ./config.yml)
#   RAG_SNAPSHOT=             optional: pin this instance to one snapshot id

# Production VM only: makes a `docker compose ...` without -f act on the data
# layer alone, never starting a default-version agent/web inside the data-layer
# project. Self-hosters must NOT set it (it would hide agent and web).
# COMPOSE_FILE=compose.data.yml

# Host directories for stateful data.
POSTGRES_DATA_DIR=./storage/postgres/volume
INDEXER_DATA_DIR=./indexer/data

# PostgreSQL credentials — the official image requires these as plain
# environment variables. This superuser is only for postgres itself and the
# indexer (the sole writer, which builds and publishes RAG snapshots); the
# agent uses it only as a fallback when POSTGRES_AGENT_PASSWORD is unset.
# POSTGRES_HOST/PORT are fixed service wiring set in the compose files.
POSTGRES_DB=postgres_db
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password

# Optional, recommended: password of the read-only `rag_agent` role. The
# indexer creates the role and syncs this password on every start; the agent
# then connects as rag_agent and cannot modify any data. Unset -> the role
# cannot log in and the agent falls back to the superuser above (with a
# warning). To change it: edit it here, then restart the indexer and agent.
POSTGRES_AGENT_PASSWORD=

# Embedding vector dimension: the dimension of the vector space the indexer
# builds snapshots in, and of the agent's query vectors. MUST equal the
# embedding model's output size (see config.example.yml). Changing it (or the
# model) makes the indexer build a new snapshot; it never alters a live table.
EMBEDDING_DIM=2560
