# Template for the .env subset that MUST be environment variables:
# docker compose interpolation, the postgres official image / init.sh, and
# compose port mappings. Everything else lives in config.yml (see its template
# config.example.yml). The two files are intentionally disjoint.

# Docker image tag for the app services ("latest" tracks the newest release).
IMAGE_TAG=latest

# Host port for the web service (plain HTTP, no TLS).
FRONTEND_PORT=8080

# Host directories for stateful data.
POSTGRES_DATA_DIR=./storage/postgres/volume
INDEXER_DATA_DIR=./indexer/data

# PostgreSQL credentials — the official image requires these as plain
# environment variables. This superuser is only for postgres itself and the
# indexer (the sole writer, which builds and publishes RAG snapshots); the
# agent uses it only as a fallback when POSTGRES_AGENT_PASSWORD is unset.
# POSTGRES_HOST/PORT are fixed service wiring set in docker-compose.yml.
POSTGRES_DB=postgres_db
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password

# Optional, recommended: password of the read-only `rag_agent` role. The
# indexer creates the role and syncs this password on every start; the agent
# then connects as rag_agent and cannot modify any data. Unset -> the role
# cannot log in and the agent falls back to the superuser above (with a
# warning). To change it: edit it here, then restart the indexer and agent.
POSTGRES_AGENT_PASSWORD=

# Embedding vector dimension: the dimension of the vector space the indexer
# builds snapshots in, and of the agent's query vectors. MUST equal the
# embedding model's output size (see config.example.yml). Changing it (or the
# model) makes the indexer build a new snapshot; it never alters a live table.
EMBEDDING_DIM=2560
